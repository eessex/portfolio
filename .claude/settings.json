{
  "permissions": {
    "allow": [
      "Bash(npx jest)",
      "Bash(npx jest *)",
      "Bash(NODE_OPTIONS=--no-deprecation npx jest)",
      "Bash(NODE_OPTIONS=--no-deprecation npx jest *)",
      "Bash(npx tsc *)",
      "Bash(npx eslint *)",
      "Bash(npx prettier *)",
      "Bash(pnpm lint *)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm build *)",
      "Bash(git checkout *)",
      "Bash(git stash *)",
      "Bash(git add *)",
      "Bash(git pull *)",
      "Bash(git log *)",
      "mcp__Claude_Preview__preview_screenshot",
      "mcp__Claude_Preview__preview_list"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(node -pe 'const j=JSON.parse(require(\"fs\").readFileSync(0,\"utf8\")); j.tool_response?.filePath ?? j.tool_input?.file_path ?? \"\"' 2>/dev/null); [ -n \"$f\" ] && pnpm exec prettier --write --ignore-unknown \"$f\" 2>/dev/null; true",
            "timeout": 30,
            "statusMessage": "Formatting with prettier"
          }
        ]
      }
    ]
  }
}
