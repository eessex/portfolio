# ── Database (required) ──
# Neon Postgres connection strings, named as the Vercel + Neon
# integration sets them (automatic when Neon is added from the
# project's Storage tab). DATABASE_URL is the pooled one (host ends
# in -pooler). Neon's console snippet names them differently: put its
# DATABASE_URL_POOLED here and its DATABASE_URL in
# DATABASE_URL_UNPOOLED.
DATABASE_URL=
# Direct connection, used by `pnpm migrate`. Optional: when unset, it
# is derived from DATABASE_URL by dropping -pooler from the host.
# DATABASE_URL_UNPOOLED=

# Preview builds only (set in Vercel, scoped to Preview): migrate each
# preview's own Neon branch. Needs both; see CONTRIBUTING.md →
# "Migrating preview deployments". The host is bare, e.g.
# ep-name-123.us-east-1.aws.neon.tech, not a URL.
# MIGRATE_PREVIEWS=1
# PRODUCTION_DATABASE_HOST=

# ── Auth (required) ──
# Unique per instance. Generate with: npx auth secret
AUTH_SECRET=
# Optional on Vercel (auto-detected). Set only if you hit
# login callback-URL problems.
# AUTH_URL=https://your-site.com

# ── File storage ──
# s3 or blob. When unset: blob if BLOB_READ_WRITE_TOKEN is set, else s3.
# To switch, run `pnpm run copy-storage --to <provider>` first.
# STORAGE_PROVIDER=

# Vercel Blob. Set automatically when a Blob store is connected to
# the Vercel project; copy it from the store's settings for local dev.
# BLOB_READ_WRITE_TOKEN=

# S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_S3_REGION=
# The next/image allow-list host is derived from the bucket +
# region above. Set REMOTE_IMAGE_HOSTNAME only to override it for
# a non-standard S3 endpoint.
# REMOTE_IMAGE_HOSTNAME=
