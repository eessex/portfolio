{
  "name": "portfolio-cms",
  "version": "0.1.0",
  "license": "FSL-1.1-ALv2",
  "private": true,
  "packageManager": "pnpm@11.0.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "setup": "node --import tsx scripts/setup.ts",
    "migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "backfill-image-variants": "node --env-file=.env --import tsx scripts/backfill-image-variants.ts",
    "copy-storage": "node --env-file=.env --import tsx scripts/copy-storage.ts",
    "migrate-mongo": "node --env-file=.env --import tsx scripts/migrate-mongo.ts",
    "reset-password": "node --env-file-if-exists=.env --import tsx scripts/reset-password.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prettier": "prettier --write .",
    "test": "NODE_ENV=test NODE_OPTIONS=--no-deprecation jest",
    "test:watch": "npm run test -- --watch",
    "test:quiet": "npm run test -- --silent --noStackTrace",
    "check": "pnpm typecheck && pnpm lint && pnpm test:quiet && pnpm build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@aws-sdk/s3-request-presigner": "^3.1075.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@heroicons/react": "^2.2",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.2",
    "@vercel/speed-insights": "^2.0.0",
    "bcrypt": "^6.0",
    "clsx": "^2.1",
    "dompurify": "^3.4.17",
    "js-cookie": "^3.0.8",
    "jsdom": "^26.1.0",
    "next": "16.4.1",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sharp": "^0.35.5",
    "zod": "^4"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.2",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/jest-dom": "^6.9",
    "@testing-library/react": "^16.3",
    "@testing-library/user-event": "^14",
    "@types/bcrypt": "^6.0",
    "@types/jest": "^30.0",
    "@types/js-cookie": "^3.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^26",
    "@types/react": "19.2",
    "@types/react-dom": "19.2",
    "eslint": "^9",
    "eslint-config-next": "16.2",
    "eslint-plugin-simple-import-sort": "^12",
    "jest": "^30.4",
    "jest-environment-jsdom": "^30.4",
    "jest-fetch-mock": "^3",
    "postcss": "^8.5",
    "prettier": "^3.8",
    "sass": "^1.101",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "^6",
    "typescript-eslint": "^8.62"
  }
}
